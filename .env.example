# Flask app
HOST=0.0.0.0
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=triad_dms

# Security — change these in any shared environment
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_EXPIRES_HOURS=24

# Uploads
MAX_CONTENT_MB=25
# The assignment's sample test uploads anonymously; set true to require a token.
REQUIRE_AUTH_FOR_UPLOAD=false

# OCR
OCR_ENABLED=true
OCR_MAX_PAGES=15
OCR_MAX_CHARS=200000
OCR_TIMEOUT_SECONDS=30
# Optional: full path to tesseract when it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Bootstrap data
SEED_DEFAULTS=true
# Emails that are granted the admin role on registration (comma separated).
ADMIN_EMAILS=admin@triad.ai
